{
  "name": "igv-single-svg-studio",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "description": "IGV Single SVG Studio — desktop editor for publication-grade IGV vector figures",
  "author": "IGV Studio",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "standalone": "node scripts/make-standalone.mjs",
    "electron": "electron .",
    "pack:app": "node scripts/pack-electron.mjs",
    "dist:mac": "npm run build && npm run standalone && npm run pack:app && electron-builder --config electron-builder.yml --mac dmg zip",
    "dist:win": "npm run build && npm run standalone && npm run pack:app && electron-builder --config electron-builder.yml --win nsis",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:real": "node scripts/e2e-real.mjs",
    "test:pdf": "node scripts/t8-pdf.mjs",
    "poc:svgedit": "node scripts/run-poc.mjs",
    "audit:perf": "node scripts/audit-perf.mjs",
    "audit:download": "node scripts/audit-download.mjs && node scripts/audit-download-file.mjs",
    "pack": "node scripts/pack.mjs",
    "app": "node scripts/make-app.mjs",
    "test:drop": "node scripts/e2e-drop.mjs",
    "test:batch": "node scripts/e2e-batch.mjs",
    "test:layers": "node scripts/e2e-layers.mjs",
    "test:zoom": "node scripts/test-zoom-stability.mjs",
    "perf:15": "FIXTURE=fixtures/panel_15tracks_stress.svg OUT=docs/validation/perf_15tracks.json node scripts/perf-v2.mjs",
    "record": "node scripts/record-demo.mjs",
    "test:electron": "node scripts/e2e-electron.mjs",
    "test:canvas-zoom": "node scripts/e2e-canvas-zoom.mjs",
    "perf:memory": "node scripts/perf-memory.mjs",
    "test:apply-all": "node scripts/e2e-apply-all.mjs",
    "test:standalone": "node scripts/e2e-standalone.mjs",
    "perf": "node scripts/perf-v2.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --bundles app",
    "tauri:build:x64": "tauri build --target x86_64-apple-darwin --bundles app",
    "bench:electron": "node scripts/bench-electron.mjs",
    "bench:coldstart": "node scripts/bench-coldstart.mjs",
    "build:selftest": "tsc --noEmit && vite build --mode selftest",
    "test:audit": "node scripts/e2e-audit.mjs",
    "test:edge": "node scripts/e2e-edge.mjs"
  },
  "dependencies": {
    "@svgedit/svgcanvas": "^7.4.2",
    "@tauri-apps/api": "^2.12.4",
    "fflate": "^0.8.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "resedit": "^3.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
